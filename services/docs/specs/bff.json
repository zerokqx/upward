{
  "openapi": "3.0.0",
  "paths": {
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь успешно зарегистрирован"
          },
          "400": {
            "description": "Невалидные входные данные"
          },
          "409": {
            "description": "Пользователь с таким email уже существует"
          }
        },
        "summary": "Регистрация нового пользователя по email и паролю",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная аутентификация, возвращен Access токен в теле и Refresh токен в HttpOnly cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Невалидные учетные данные"
          },
          "401": {
            "description": "Неверный пароль"
          },
          "404": {
            "description": "Пользователь не найден"
          }
        },
        "summary": "Аутентификация по email и паролю",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access токен успешно обновлен, новый Refresh токен сохранен в HttpOnly cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Невалидный или протухший Refresh токен"
          }
        },
        "summary": "Обновление пары токенов (Token Rotation)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешный выход"
          }
        },
        "summary": "Выход из системы (очистка HttpOnly cookie)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/google": {
      "get": {
        "operationId": "AuthController_googleLogin",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Редирект на страницу согласия Google"
          }
        },
        "summary": "Инициация входа через Google OAuth",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/google/callback": {
      "get": {
        "operationId": "AuthController_googleCallback",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешная аутентификация через Google"
          }
        },
        "summary": "OAuth Callback для завершения входа через Google",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Данные текущего пользователя"
          },
          "401": {
            "description": "Пользователь не авторизован"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Получение профиля текущего авторизованного пользователя",
        "tags": [
          "Auth"
        ]
      }
    },
    "/sites": {
      "post": {
        "operationId": "SitesController_createSite",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSiteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Сайт успешно зарегистрирован",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSiteResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Невалидный URL или ошибка DNS-резолвинга"
          },
          "401": {
            "description": "Пользователь не авторизован"
          },
          "403": {
            "description": "Запрещено: IP является приватным или заблокирован"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Регистрация нового сайта для мониторинга",
        "tags": [
          "Sites"
        ]
      },
      "get": {
        "operationId": "SitesController_getAllSites",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Список сайтов пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SiteResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Получить список отслеживаемых сайтов текущего пользователя",
        "tags": [
          "Sites"
        ]
      }
    },
    "/sites/{id}/verify": {
      "post": {
        "operationId": "SitesController_verifySite",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Владение сайтом успешно подтверждено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifySiteResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Токен не совпадает или некорректный ответ сайта"
          },
          "401": {
            "description": "Пользователь не авторизован"
          },
          "404": {
            "description": "Сайт не найден"
          },
          "502": {
            "description": "Ошибка связи с целевым сайтом"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Подтвердить владение сайтом через HTTP-01 Challenge",
        "tags": [
          "Sites"
        ]
      }
    },
    "/sites/{id}/pings": {
      "get": {
        "operationId": "SitesController_getPings",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "История замеров доступности за последние 30 дней",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PingRecordDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован"
          },
          "404": {
            "description": "Сайт не найден"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "История замеров доступности сайта",
        "tags": [
          "Sites"
        ]
      }
    }
  },
  "info": {
    "title": "Upward BFF API",
    "description": "Backend-For-Frontend API для веб- и мобильных клиентов Upward: единая точка входа для авторизации и мониторинга сайтов",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "BFF Gateway (Local)"
    },
    {
      "url": "/",
      "description": "Current Origin"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email пользователя"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Пароль учетной записи (от 8 до 128 символов)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email пользователя"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Пароль пользователя"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string",
            "description": "JWT токен доступа (Bearer)"
          }
        },
        "required": [
          "access"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refresh": {
            "description": "Refresh токен сессии (UUID v4, опционально, если передан в HttpOnly cookie)",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        }
      },
      "CreateSiteDto": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "URL сайта для проверки (поддерживаются протоколы http:// и https://)"
          }
        },
        "required": [
          "site"
        ]
      },
      "CreateSiteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор созданного сайта"
          },
          "status": {
            "type": "string",
            "description": "Статус операции"
          },
          "challenge_path": {
            "type": "string",
            "description": "Путь, по которому должен быть доступен токен"
          },
          "challenge_token": {
            "type": "string",
            "description": "Секретный токен для подтверждения владения сайтом"
          }
        },
        "required": [
          "id",
          "status",
          "challenge_path",
          "challenge_token"
        ]
      },
      "SiteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор сайта"
          },
          "user_id": {
            "type": "string",
            "description": "Идентификатор пользователя-владельца"
          },
          "url": {
            "type": "string",
            "description": "Отслеживаемый URL"
          },
          "active": {
            "type": "boolean",
            "description": "Признак подтверждения и активности сайта"
          },
          "status": {
            "type": "string",
            "description": "Текущий статус сайта в очереди"
          },
          "created_at": {
            "type": "string",
            "description": "Время добавления сайта (UTC)"
          },
          "status_updated_at": {
            "type": "string",
            "description": "Время обновления статуса (UTC)"
          },
          "last_check": {
            "description": "Время последней проверки (UTC)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extra": {
            "description": "Дополнительные данные последней проверки",
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "user_id",
          "url",
          "active",
          "status",
          "created_at",
          "status_updated_at"
        ]
      },
      "VerifySiteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор подтвержденного сайта"
          },
          "status": {
            "type": "string",
            "description": "Статус операции"
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "PingRecordDto": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "description": "Идентификатор сайта"
          },
          "duration_ms": {
            "type": "number",
            "description": "Длительность ответа в миллисекундах"
          },
          "extra": {
            "description": "Дополнительные метаданные замера",
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "site_id",
          "duration_ms"
        ]
      }
    }
  }
}
