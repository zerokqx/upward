<mxfile host="app.diagrams.net">
  <diagram id="uptime-architecture" name="Uptime Microservice Architecture">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1680" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="header_banner" value="&lt;b&gt;UPWARD ARCHITECTURE — МИКРОСЕРВИС UPTIME (Rust / Tokio / Axum / SQLx / TimescaleDB / Redis)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:12px;color:#64748B;font-weight:normal;&#x27;&gt;Полнофункциональная архитектура сервиса мониторинга доступности: асинхронный HTTP API сервер, защитный контур против SSRF и DNS Rebinding, высокопроизводительный распределённый воркер батчевых проверок, модель хранения TimescaleDB и верификация доменов через HTTP-01.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=24;verticalAlign=middle;fontColor=#0F172A;fontSize=15;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="2340" height="65" as="geometry" /></mxCell>
<mxCell id="box_clients" value="&lt;b&gt;Клиенты и внешние потребители API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="560" as="geometry" /></mxCell>
<mxCell id="client_bff" value="&lt;b&gt;Backend-for-Frontend (BFF)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;services/bff (NestJS / TypeScript)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Регистрация сайтов: &lt;i&gt;POST /sites&lt;/i&gt;&lt;br/&gt;• Запрос списка сайтов: &lt;i&gt;GET /sites/:id&lt;/i&gt;&lt;br/&gt;• История проверок: &lt;i&gt;GET /pings&lt;/i&gt;&lt;br/&gt;• Запуск верификации: &lt;i&gt;POST /verify&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="270" height="105" as="geometry" /></mxCell>
<mxCell id="client_browser" value="&lt;b&gt;Web UI / Dashboard&lt;/b&gt;&lt;br/&gt;&lt;i&gt;React / Web Client&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Отображение статусов сайтов&lt;br/&gt;• Графики задержек (RT latency)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#F0FDFA;strokeColor=#14B8A6;strokeWidth=1.5;fontColor=#134E4A;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="270" width="270" height="75" as="geometry" /></mxCell>
<mxCell id="client_infra" value="&lt;b&gt;Orchestrator Probes&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Docker / Kubernetes Kubelet&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Liveness probe: &lt;i&gt;GET /health&lt;/i&gt;&lt;br/&gt;• Readiness probe готовности пода" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="360" width="270" height="75" as="geometry" /></mxCell>
<mxCell id="client_swagger" value="&lt;b&gt;Developer &amp; OpenAPI UI&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Swagger UI / Postman / curl&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Спецификация: &lt;i&gt;/docs/docs.json&lt;/i&gt;&lt;br/&gt;• UI интерфейс: &lt;i&gt;/docs&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="450" width="270" height="75" as="geometry" /></mxCell>
<mxCell id="meta_network_info" value="&lt;b&gt;Сетевой протокол сервиса:&lt;/b&gt;&lt;br/&gt;• Порт: &lt;b&gt;:3000&lt;/b&gt; (env: PORT)&lt;br/&gt;• Хост: &lt;b&gt;127.0.0.1&lt;/b&gt; / 0.0.0.0&lt;br/&gt;• Формат: &lt;b&gt;JSON / REST API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#475569;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="55" y="540" width="270" height="110" as="geometry" /></mxCell>
<mxCell id="box_uptime_service" value="&lt;b&gt;Микросервис Uptime (Rust Application Process — Tokio Multi-threaded Async Runtime)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="365" y="110" width="1560" height="1145" as="geometry" /></mxCell>
<mxCell id="box_axum_server" value="&lt;b&gt;1. Слой сетевого HTTP-сервера и маршрутизации (Axum Web Framework — server.rs &amp; Handlers)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="385" y="145" width="1520" height="280" as="geometry" /></mxCell>
<mxCell id="node_axum_core" value="&lt;b&gt;Axum Router Engine&lt;/b&gt;&lt;br/&gt;&lt;i&gt;src/server.rs (create_app)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Router::new()&lt;/b&gt;&lt;br/&gt;• Tracing Subscriber (DEBUG)&lt;br/&gt;• Внедрение состояния: &lt;b&gt;AppState&lt;/b&gt;&lt;br/&gt;• Асинхронный Non-blocking I/O loop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="405" y="185" width="210" height="220" as="geometry" /></mxCell>
<mxCell id="ep_health" value="&lt;b&gt;Health Check Controller&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;background:#10B981;color:#fff;padding:2px 5px;border-radius:3px;font-size:9px;&#x27;&gt;GET&lt;/span&gt; &lt;b&gt;/health&lt;/b&gt;&lt;br/&gt;Возврат &lt;b&gt;HealthResponseDto&lt;/b&gt; { status: &#x27;ok&#x27;, message: &#x27;...&#x27; }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.2;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="645" y="185" width="300" height="95" as="geometry" /></mxCell>
<mxCell id="ep_swagger" value="&lt;b&gt;OpenAPI / Swagger UI&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;background:#10B981;color:#fff;padding:2px 5px;border-radius:3px;font-size:9px;&#x27;&gt;GET&lt;/span&gt; &lt;b&gt;/docs&lt;/b&gt; | &lt;b&gt;/docs/docs.json&lt;/b&gt;&lt;br/&gt;utoipa + utoipa-swagger-ui (Автосхема OpenAPI 3.0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.2;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="975" y="185" width="310" height="95" as="geometry" /></mxCell>
<mxCell id="ep_sites" value="&lt;b&gt;Site Controller (src/site/controller.rs)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;background:#3B82F6;color:#fff;padding:1px 4px;border-radius:3px;font-size:9px;&#x27;&gt;POST&lt;/span&gt; &lt;b&gt;/sites&lt;/b&gt; — Регистрация сайта (CreateSiteDto { site, user_id })&lt;br/&gt;&lt;span style=&#x27;background:#10B981;color:#fff;padding:1px 4px;border-radius:3px;font-size:9px;&#x27;&gt;GET&lt;/span&gt; &lt;b&gt;/sites/{user_id}&lt;/b&gt; — Список сайтов пользователя с метаданными пинга&lt;br/&gt;&lt;span style=&#x27;background:#3B82F6;color:#fff;padding:1px 4px;border-radius:3px;font-size:9px;&#x27;&gt;POST&lt;/span&gt; &lt;b&gt;/sites/{site_id}/verify&lt;/b&gt; — HTTP-01 Challenge верификация владения" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.2;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="645" y="295" width="640" height="110" as="geometry" /></mxCell>
<mxCell id="ep_pings" value="&lt;b&gt;Ping Controller (src/ping/controller.rs)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;background:#10B981;color:#fff;padding:2px 5px;border-radius:3px;font-size:9px;&#x27;&gt;GET&lt;/span&gt; &lt;b&gt;/sites/{site_id}/pings&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Query params: &lt;i&gt;user_id&lt;/i&gt;&lt;br/&gt;• Выборка истории проверок доступности за 30 дней&lt;br/&gt;• Чтение гипертаблицы &lt;b&gt;site_pings&lt;/b&gt;&lt;br/&gt;• Возврат DTO: &lt;i&gt;Vec&amp;lt;PingRecord&amp;gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.2;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1315" y="185" width="570" height="220" as="geometry" /></mxCell>
<mxCell id="box_security" value="&lt;b&gt;2. Защита от SSRF и аудит IP (IpValidator — src/site/controller.rs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#FAF5FF;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#6B21A8;" vertex="1" parent="1"><mxGeometry x="385" y="440" width="740" height="275" as="geometry" /></mxCell>
<mxCell id="node_ip_validator" value="&lt;b&gt;Компонент IpValidator (Защита периметра)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Многоступенчатая фильтрация перед каждым сетевым обращением&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. Проверка схемы:&lt;/b&gt; Разрешены исключительно &lt;i&gt;http://&lt;/i&gt; и &lt;i&gt;https://&lt;/i&gt;.&lt;br/&gt;&lt;b&gt;2. DNS-резолвинг:&lt;/b&gt; &lt;i&gt;tokio::net::lookup_host(host:port)&lt;/i&gt; с валидацией всех IP.&lt;br/&gt;&lt;b&gt;3. Фильтрация Богонов и Приватных подсетей (IPv4 &amp; IPv6):&lt;/b&gt;&lt;br/&gt;   • &lt;b&gt;IPv4:&lt;/b&gt; Loopback (127/8), RFC 1918 (10/8, 172.16/12, 192.168/16)&lt;br/&gt;   • &lt;b&gt;Специальные:&lt;/b&gt; CGNAT (100.64/10), Test-Nets (192.0.2/24, 198.51.100/24)&lt;br/&gt;   • &lt;b&gt;Сетевые:&lt;/b&gt; Link-Local (169.254/16), Broadcast, Multicast, Unspecified&lt;br/&gt;   • &lt;b&gt;IPv6:&lt;/b&gt; ::1, fc00::/7, fe80::/10, IPv4-mapped IPv6 адреса&lt;br/&gt;&lt;b&gt;4. Blacklist в БД:&lt;/b&gt; Поиск IP в таблице &lt;i&gt;forbidden_ip&lt;/i&gt;.&lt;br/&gt;&lt;b&gt;5. Anti-DNS Rebinding:&lt;/b&gt; Повторная валидация в воркере перед отправкой пинга." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;strokeWidth=1.2;fontColor=#3B0764;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="405" y="475" width="700" height="225" as="geometry" /></mxCell>
<mxCell id="box_app_state" value="&lt;b&gt;3. Доменный слой, AppState и Репозитории (src/domain.rs &amp; Repositories)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="1145" y="440" width="760" height="275" as="geometry" /></mxCell>
<mxCell id="node_app_state" value="&lt;b&gt;Структура AppState (Shared State)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;src/main.rs (Clone-контекст)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;pool:&lt;/b&gt; &lt;i&gt;sqlx::PgPool&lt;/i&gt; (Пул соединений Postgres, max=5)&lt;br/&gt;• &lt;b&gt;site_repo:&lt;/b&gt; &lt;i&gt;SiteRepository&lt;/i&gt; (CRUD сайтов, atomic CTE)&lt;br/&gt;• &lt;b&gt;ping_repo:&lt;/b&gt; &lt;i&gt;PingRepository&lt;/i&gt; (Батчевая запись в гипертаблицу)&lt;br/&gt;• &lt;b&gt;forbidden_ip_repo:&lt;/b&gt; &lt;i&gt;ForbiddenIpRepository&lt;/i&gt; (Черный список)&lt;br/&gt;• &lt;b&gt;challenge_repo:&lt;/b&gt; &lt;i&gt;ChallengeRepository&lt;/i&gt; (Redis токен-хранилище)&lt;br/&gt;• &lt;b&gt;redis:&lt;/b&gt; &lt;i&gt;redis::aio::MultiplexedConnection&lt;/i&gt; (Мультиплексор)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.2;fontColor=#14532D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1165" y="475" width="460" height="225" as="geometry" /></mxCell>
<mxCell id="node_domain_types" value="&lt;b&gt;Domain Newtypes&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Безопасность типов&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;SiteId(pub Uuid)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;UserId(pub String)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;SiteUrl(pub String)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;SiteStatus&lt;/b&gt; (Idle/Proc)&lt;br/&gt;• &lt;b&gt;Site&lt;/b&gt; (Entity)&lt;br/&gt;• &lt;b&gt;PingRecord&lt;/b&gt; (Metric)&lt;br/&gt;• &lt;b&gt;PingExecution&lt;/b&gt; (Duration)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.2;fontColor=#14532D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1645" y="475" width="240" height="225" as="geometry" /></mxCell>
<mxCell id="box_worker" value="&lt;b&gt;4. Высокопроизводительный фоновый воркер проверок (Background Ping Worker — spawn_uptime_worker)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=1.5;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="385" y="730" width="1520" height="505" as="geometry" /></mxCell>
<mxCell id="worker_lifecycle" value="&lt;b&gt;Конфигурация и рантайм воркера&lt;/b&gt;&lt;br/&gt;&lt;i&gt;tokio::spawn(async move { loop { ... } })&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Интервал тикера:&lt;/b&gt; &lt;i&gt;tokio::time::interval(10 сек)&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Пул соединений HTTP:&lt;/b&gt; &lt;i&gt;reqwest::Client&lt;/i&gt; (reusable socket pool)&lt;br/&gt;  - &lt;i&gt;timeout: 10 сек&lt;/i&gt; (защита от медленных ответов)&lt;br/&gt;  - &lt;i&gt;redirect policy: none&lt;/i&gt; (предотвращение атак перенаправления)&lt;br/&gt;  - &lt;i&gt;User-Agent: &#x27;UptimeMonitor/1.0&#x27;&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Параметры масштабирования (WorkerConfig):&lt;/b&gt;&lt;br/&gt;  - &lt;i&gt;PING_BATCH_SIZE: 500&lt;/i&gt; (размер пачки сайтов за 1 тик)&lt;br/&gt;  - &lt;i&gt;PING_CONCURRENCY: 25&lt;/i&gt; (максимум одновременных сокетов)&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Производительность:&lt;/b&gt; Пачка в 500 сайтов за ~2-4 сек без исчерпания сокетов." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="405" y="770" width="340" height="445" as="geometry" /></mxCell>
<mxCell id="pipe_step1" value="&lt;b&gt;ШАГ 1: Атомарный захват батча (FOR UPDATE SKIP LOCKED)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;SiteRepository::get_sites_for_ping(batch_size)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Один транзакционный SQL-запрос с Common Table Expression (CTE):&lt;/b&gt;&lt;br/&gt;  &lt;span style=&#x27;font-family:Courier;font-size:10px;&#x27;&gt;WITH target_sites AS (&lt;br/&gt;    SELECT id FROM sites&lt;br/&gt;    WHERE active = TRUE AND (&lt;br/&gt;      (status = &#x27;idle&#x27; AND (last_check IS NULL OR last_check &amp;lt; NOW() - &#x27;60s&#x27;))&lt;br/&gt;      OR (status = &#x27;processing&#x27; AND status_updated_at &amp;lt; NOW() - &#x27;3m&#x27;)&lt;br/&gt;    ) ORDER BY last_check ASC NULLS FIRST&lt;br/&gt;    LIMIT $1 FOR UPDATE SKIP LOCKED&lt;br/&gt;  ) UPDATE sites SET status = &#x27;processing&#x27;, status_updated_at = NOW()&lt;br/&gt;  RETURNING id, url, user_id, active;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Гарантии:&lt;/b&gt; Никаких состояний гонки между подами, блокировка длится &amp;lt;2 мс,&lt;br/&gt;  автоматический перехват упавших зомби-воркеров (статус &#x27;processing&#x27; &amp;gt; 3 мин)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="770" width="545" height="210" as="geometry" /></mxCell>
<mxCell id="pipe_step2" value="&lt;b&gt;ШАГ 2: Конкурентный замер &amp; Re-SSRF аудит&lt;/b&gt;&lt;br/&gt;&lt;i&gt;stream::iter(sites).map(...).buffer_unordered(concurrency)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Окно параллелизма:&lt;/b&gt; Ограничено &lt;i&gt;concurrency = 25&lt;/i&gt; (нет всплесков DNS/сокетов).&lt;br/&gt;• &lt;b&gt;check_single_site:&lt;/b&gt; Повторная валидация через &lt;i&gt;IpValidator::validate_url&lt;/i&gt; непосредственно&lt;br/&gt;  перед сетевым вызовом (защита от Time-of-Check to Time-of-Use DNS Rebinding).&lt;br/&gt;• &lt;b&gt;HttpPinger::ping:&lt;/b&gt; Замер &lt;i&gt;start.elapsed()&lt;/i&gt;, парсинг тела в &lt;i&gt;extra JSON&lt;/i&gt;.&lt;br/&gt;• Сетевые сбои логируются как запись пинга с &lt;i&gt;duration_ms: 0.0, extra: { error: &#x27;...&#x27; }&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1330" y="770" width="555" height="210" as="geometry" /></mxCell>
<mxCell id="pipe_step3" value="&lt;b&gt;ШАГ 3: Массовая батчевая вставка (Batch INSERT)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;PingRepository::save_pings_batch(&amp;results)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Построение динамического мультистрочного SQL через &lt;b&gt;sqlx::QueryBuilder&lt;/b&gt;:&lt;br/&gt;  &lt;span style=&#x27;font-family:Courier;font-size:10px;&#x27;&gt;INSERT INTO site_pings (time, site_id, duration_ms, extra)&lt;br/&gt;  VALUES (NOW(), $1, $2, $3), (NOW(), $4, $5, $6), ...&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;Преимущество:&lt;/b&gt; Ровно 1 сетевой round-trip к Postgres на 500 записей вместо 500 отдельных INSERT,&lt;br/&gt;  не перегружает пул соединений базы данных (max_connections = 5)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="765" y="1005" width="545" height="210" as="geometry" /></mxCell>
<mxCell id="pipe_step4" value="&lt;b&gt;ШАГ 4: Массовое освобождение статуса сайтов&lt;/b&gt;&lt;br/&gt;&lt;i&gt;SiteRepository::mark_sites_idle(&amp;site_ids)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Обновление состояния проверенных сайтов одним запросом:&lt;br/&gt;  &lt;span style=&#x27;font-family:Courier;font-size:10px;&#x27;&gt;UPDATE sites SET status = &#x27;idle&#x27;,&lt;br/&gt;  status_updated_at = NOW(), last_check = NOW()&lt;br/&gt;  WHERE id = ANY($1);&lt;/span&gt;&lt;br/&gt;• Сайты возвращаются в статус &lt;i&gt;idle&lt;/i&gt; и будут снова проверены через 60 секунд." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.2;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1330" y="1005" width="555" height="210" as="geometry" /></mxCell>
<mxCell id="box_external_targets" value="&lt;b&gt;Внешняя сеть и целевые ресурсы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1945" y="110" width="435" height="780" as="geometry" /></mxCell>
<mxCell id="target_dns" value="&lt;b&gt;DNS-серверы (Система / Публичные)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;8.8.8.8, 1.1.1.1, локальный resolv.conf&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Резолвинг хоста при регистрации сайта&lt;br/&gt;• Проверка перед HTTP-01 challenge&lt;br/&gt;• Резолвинг при каждом фоновом пинге" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.2;fontColor=#111827;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1965" y="155" width="395" height="105" as="geometry" /></mxCell>
<mxCell id="target_web" value="&lt;b&gt;Отслеживаемые веб-сервисы (Цели)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Внешние сайты пользователей (https://example.com)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Обычный пинг:&lt;/b&gt; &lt;i&gt;HTTP GET {url}&lt;/i&gt;&lt;br/&gt;  - Замер времени отклика сервера (TTFB + Body)&lt;br/&gt;  - Чтение опционального JSON со статусом" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.2;fontColor=#111827;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1965" y="280" width="395" height="110" as="geometry" /></mxCell>
<mxCell id="target_wellknown" value="&lt;b&gt;HTTP-01 Challenge Endpoint&lt;/b&gt;&lt;br/&gt;&lt;i&gt;{site.url}/.well-known/upward&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Проверка владения доменом:&lt;/b&gt;&lt;br/&gt;  - Размещение токена в &lt;i&gt;/.well-known/upward&lt;/i&gt;&lt;br/&gt;  - Uptime делает GET запрос (таймаут 5с, no redirects)&lt;br/&gt;  - Сверка токена с Redis и активация сайта" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FEF9C3;strokeColor=#EAB308;strokeWidth=1.2;fontColor=#713F12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1965" y="410" width="395" height="145" as="geometry" /></mxCell>
<mxCell id="target_blocked" value="&lt;b&gt;Запрещенные адреса (Отклоняются)&lt;/b&gt;&lt;br/&gt;• 127.0.0.1, localhost, 169.254.169.254 (AWS meta)&lt;br/&gt;• 10.0.0.0/8, 192.168.0.0/16, ::1&lt;br/&gt;• Адреса из таблицы &lt;i&gt;forbidden_ip&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Результат:&lt;/b&gt; HTTP 403 Forbidden / Error Log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.2;fontColor=#991B1B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1965" y="575" width="395" height="125" as="geometry" /></mxCell>
<mxCell id="target_security_summary" value="&lt;b&gt;Гарантия изоляции сети:&lt;/b&gt;&lt;br/&gt;Сервис uptime принципиально не имеет доступа во внутренний периметр инфраструктуры благодаря строгой валидации IP до каждого сетевого коннекта." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#4B5563;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1965" y="720" width="395" height="150" as="geometry" /></mxCell>
<mxCell id="box_infra" value="&lt;b&gt;5. Слой хранения данных и инфраструктура (Docker Compose — compose.infra.yml)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="365" y="1275" width="1560" height="375" as="geometry" /></mxCell>
<mxCell id="db_timescale" value="&lt;b&gt;TimescaleDB / PostgreSQL 17 (uptime-timescale:5432)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Образ: timescale/timescaledb:latest-pg17 | База: uptimedb&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Таблица &#x27;sites&#x27;:&lt;/b&gt;&lt;br/&gt;  - &lt;b&gt;id:&lt;/b&gt; UUID PRIMARY KEY (gen_random_uuid())&lt;br/&gt;  - &lt;b&gt;user_id:&lt;/b&gt; TEXT NOT NULL (usr_...)&lt;br/&gt;  - &lt;b&gt;url:&lt;/b&gt; TEXT NOT NULL&lt;br/&gt;  - &lt;b&gt;status:&lt;/b&gt; VARCHAR(20) DEFAULT &#x27;idle&#x27; (&#x27;idle&#x27; | &#x27;processing&#x27;)&lt;br/&gt;  - &lt;b&gt;last_check:&lt;/b&gt; TIMESTAMPTZ (индекс: &lt;i&gt;ASC NULLS FIRST&lt;/i&gt;)&lt;br/&gt;  - &lt;b&gt;status_updated_at:&lt;/b&gt; TIMESTAMPTZ DEFAULT NOW()&lt;br/&gt;  - &lt;b&gt;active:&lt;/b&gt; BOOLEAN NOT NULL DEFAULT FALSE&lt;br/&gt;• &lt;b&gt;Гипертаблица &#x27;site_pings&#x27; (create_hypertable):&lt;/b&gt;&lt;br/&gt;  - &lt;b&gt;time:&lt;/b&gt; TIMESTAMPTZ (Partition Key)&lt;br/&gt;  - &lt;b&gt;site_id:&lt;/b&gt; UUID REFERENCES sites(id) ON DELETE CASCADE&lt;br/&gt;  - &lt;b&gt;duration_ms:&lt;/b&gt; DOUBLE PRECISION (время ответа в мс)&lt;br/&gt;  - &lt;b&gt;extra:&lt;/b&gt; JSONB (статус, доп. поля, ошибки сети)&lt;br/&gt;  - &lt;b&gt;Retention Policy:&lt;/b&gt; &lt;i&gt;add_retention_policy(&#x27;site_pings&#x27;, &#x27;30 days&#x27;)&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Таблица &#x27;forbidden_ip&#x27;:&lt;/b&gt; &lt;i&gt;id BIGSERIAL PK, ip TEXT UNIQUE&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="385" y="1315" width="920" height="320" as="geometry" /></mxCell>
<mxCell id="db_redis" value="&lt;b&gt;Redis 7 Alpine (uptime-redis:6379)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;In-Memory хранилище токенов челенджей&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Структура ключа:&lt;/b&gt;&lt;br/&gt;  &lt;span style=&#x27;font-family:Courier;font-size:11px;&#x27;&gt;challenge:{site_id}:{token}&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Значение:&lt;/b&gt; &lt;span style=&#x27;font-family:Courier;&#x27;&gt;1&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;TTL:&lt;/b&gt; 86400 сек (24 часа экспирация)&lt;br/&gt;• &lt;b&gt;Операции:&lt;/b&gt;&lt;br/&gt;  - &lt;i&gt;SETEX&lt;/i&gt; при создании сайта&lt;br/&gt;  - &lt;i&gt;EXISTS + DEL&lt;/i&gt; при подтверждении" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1325" y="1315" width="580" height="160" as="geometry" /></mxCell>
<mxCell id="sqlx_note" value="&lt;b&gt;Миграции SQLx (_sqlx_migrations):&lt;/b&gt;&lt;br/&gt;Управляются через Moonrepo (&lt;i&gt;moon run uptime:migrate&lt;/i&gt;).&lt;br/&gt;Включают: создание таблиц, гипертаблицы TimescaleDB, ретеншн 30 дней, переход на UUID и HTTP-01 флаг active." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1325" y="1495" width="580" height="140" as="geometry" /></mxCell>
<mxCell id="box_legend" value="&lt;b&gt;Архитектурные гарантии и легенда&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="300" height="960" as="geometry" /></mxCell>
<mxCell id="legend_items" value="&lt;b&gt;Ключевые принципы сервиса:&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. Zero-Race Concurrency:&lt;/b&gt;&lt;br/&gt;Использование &lt;i&gt;FOR UPDATE SKIP LOCKED&lt;/i&gt; гарантирует, что сколько бы реплик Uptime ни было запущено, ни один сайт не будет проверяться дважды одновременно.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Multi-tenant SSRF Shield:&lt;/b&gt;&lt;br/&gt;Полный запрет приватных адресов и валидация перед каждым HTTP-запросом защищают облачную инфраструктуру и метаданные.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. High Write Throughput:&lt;/b&gt;&lt;br/&gt;Батчевая вставка сотен пингов в один SQL-запрос снижает нагрузку на соединение с базой в сотни раз.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. TimescaleDB Partitioning:&lt;/b&gt;&lt;br/&gt;Автоматическое секционирование по времени и автоматическая ротация старых данных старше 30 дней.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. Domain Ownership:&lt;/b&gt;&lt;br/&gt;HTTP-01 challenge гарантирует, что пользователь мониторит только свои ресурсы.&lt;br/&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Цветовая дифференциация:&lt;/b&gt;&lt;br/&gt;• &lt;span style=&#x27;color:#2563EB;&#x27;&gt;■&lt;/span&gt; Синий: Слой Axum HTTP API&lt;br/&gt;• &lt;span style=&#x27;color:#7C3AED;&#x27;&gt;■&lt;/span&gt; Фиолетовый: Контур безопасности и IP&lt;br/&gt;• &lt;span style=&#x27;color:#059669;&#x27;&gt;■&lt;/span&gt; Зеленый: Фоновый воркер и пайплайн&lt;br/&gt;• &lt;span style=&#x27;color:#D97706;&#x27;&gt;■&lt;/span&gt; Желтый: TimescaleDB и Redis&lt;br/&gt;• &lt;span style=&#x27;color:#4B5563;&#x27;&gt;■&lt;/span&gt; Серый: Внешние системы и клиенты" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fontSize=11;fontFamily=Helvetica;shadow=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#334155;align=left;spacingLeft=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="55" y="730" width="270" height="905" as="geometry" /></mxCell>
<mxCell id="cell_2" value="REST API" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;exitX=1;exitY=0.5;entryX=0;entryY=0.25;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="client_bff" target="node_axum_core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_3" value="HTTP GET" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#14B8A6;strokeWidth=2;fontColor=#134E4A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="client_browser" target="node_axum_core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_4" value="Liveness" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;exitX=1;exitY=0.5;entryX=0;entryY=0.75;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="client_infra" target="node_axum_core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_5" value="API Docs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;exitX=1;exitY=0.5;entryX=0;entryY=0.9;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="client_swagger" target="node_axum_core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_6" value="/health" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;fontColor=#065F46;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="node_axum_core" target="ep_health"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_7" value="/docs" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;exitX=0.8;exitY=0;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="node_axum_core" target="ep_swagger"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="573" y="165" /><mxPoint x="1130" y="165" /></Array></mxGeometry></mxCell>
<mxCell id="cell_8" value="/sites/*" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;exitX=1;exitY=0.75;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="node_axum_core" target="ep_sites"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cell_9" value="/pings" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;exitX=0.8;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="node_axum_core" target="ep_pings"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="573" y="415" /><mxPoint x="1600" y="415" /></Array></mxGeometry></mxCell>
<mxCell id="cell_10" value="Валидация URL / Anti-SSRF" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;exitX=0.25;exitY=1;entryX=0.6;entryY=0;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;" edge="1" parent="1" source="ep_sites" target="node_ip_validator"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
